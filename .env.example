# Voorbeeldconfiguratie voor lokale ontwikkeling.
# Kopieer dit bestand naar .env (dat bestand wordt NIET in Git opgeslagen):
#   cp .env.example .env
# en kies daarna een eigen wachtwoord.
#
# Zowel Docker Compose als de Spring Boot-backend (profiel "local") lezen deze waarden.

POSTGRES_DB=garantiebewaker
POSTGRES_USER=garantiebewaker
POSTGRES_PASSWORD=kies-hier-een-eigen-lokaal-wachtwoord
POSTGRES_PORT=5432
